{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "little-steps-site",
  "compatibility_date": "2026-09-14",
  // 影片的 Range 支援、cookie 同意用的 /api/geo、行銷追蹤連結 /go/*，見 worker.js
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // 只有 mp4 與 /api/geo 進 Worker，其他路徑直接由靜態資源回應
    "run_worker_first": ["/assets/*.mp4", "/api/geo", "/go/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "littlestep.me", "custom_domain": true },
    { "pattern": "www.littlestep.me", "custom_domain": true }
  ],
  // /go/* 記點擊用。anon key 本來就是公開的（App 裡也有），寫入只能透過 log_link_click()
  "vars": {
    "SUPABASE_URL": "https://sxmdlfpsbfgvrjxndipx.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN4bWRsZnBzYmZndnJqeG5kaXB4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI5ODgyNzMsImV4cCI6MjA4ODU2NDI3M30.GRPeUPJrNSfajkBXPrdCUN7ee4Z4GU4-NDiZzChxua8"
  },
  "observability": { "enabled": true }
}
